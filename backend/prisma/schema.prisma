generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Small demo uploads can live in MySQL when hosting has no persistent disk.
model uploaded_images {
  filename     String   @id @db.VarChar(80)
  content      Bytes    @db.MediumBlob
  content_type String   @db.VarChar(32)
  created_at   DateTime @default(now()) @db.Timestamp(0)
}

model addresses {
  address_id     Int                     @id @default(autoincrement())
  user_id        Int
  receiver_name  String                  @db.VarChar(100)
  receiver_phone String                  @db.VarChar(20)
  province       String                  @db.VarChar(100)
  district       String                  @db.VarChar(100)
  ward           String                  @db.VarChar(100)
  detail_address String?                 @db.VarChar(255)
  address_type   addresses_address_type? @default(home)
  is_default     Boolean?                @default(false)
  created_at     DateTime?               @default(now()) @db.Timestamp(0)
  updated_at     DateTime?               @default(now()) @db.Timestamp(0)
  users          users                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_ibfk_1")
  orders         orders[]

  @@index([user_id], map: "user_id")
}

model admin_logs {
  log_id      Int       @id @default(autoincrement())
  admin_id    Int
  action_type String    @db.VarChar(100)
  target_type String?   @db.VarChar(100)
  target_id   Int?
  description String?   @db.Text
  ip_address  String?   @db.VarChar(50)
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  users       users     @relation(fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "admin_logs_ibfk_1")

  @@index([admin_id], map: "admin_id")
}

model attributes {
  attribute_id       Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  type               attributes_type?     @default(text)
  product_attributes product_attributes[]
}

model banners {
  banner_id     Int                    @id @default(autoincrement())
  title         String?                @db.VarChar(255)
  image_url     String?                @db.VarChar(500)
  redirect_type banners_redirect_type?
  redirect_id   Int?
  position      banners_position?
  start_time    DateTime?              @db.DateTime(0)
  end_time      DateTime?              @db.DateTime(0)
  status        banners_status?        @default(active)
  created_at    DateTime?              @default(now()) @db.Timestamp(0)
}

model brands {
  brand_id    Int            @id @default(autoincrement())
  name        String         @db.VarChar(100)
  logo        String?        @db.VarChar(255)
  description String?        @db.Text
  status      brands_status? @default(active)
  created_at  DateTime?      @default(now()) @db.Timestamp(0)
  updated_at  DateTime?      @default(now()) @db.Timestamp(0)
  products    products[]
}

model cart_items {
  cart_item_id     Int               @id @default(autoincrement())
  cart_id          Int
  product_id       Int
  variant_id       Int?
  quantity         Int?              @default(1)
  added_price      Decimal?          @db.Decimal(12, 0)
  created_at       DateTime?         @default(now()) @db.Timestamp(0)
  carts            carts             @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_ibfk_1")
  products         products          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_ibfk_2")
  product_variants product_variants? @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction, map: "cart_items_ibfk_3")

  @@index([cart_id], map: "cart_id")
  @@index([product_id], map: "product_id")
  @@index([variant_id], map: "variant_id")
}

model carts {
  cart_id    Int           @id @default(autoincrement())
  user_id    Int
  status     carts_status? @default(active)
  created_at DateTime?     @default(now()) @db.Timestamp(0)
  updated_at DateTime?     @default(now()) @db.Timestamp(0)
  cart_items cart_items[]
  users      users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "carts_ibfk_1")

  @@index([user_id], map: "user_id")
}

model categories {
  category_id          Int                    @id @default(autoincrement())
  parent_id            Int?
  name                 String                 @db.VarChar(100)
  image                String?                @db.VarChar(255)
  description          String?                @db.Text
  status               categories_status?     @default(active)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  categories           categories?            @relation("categoriesTocategories", fields: [parent_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "categories_ibfk_1")
  other_categories     categories[]           @relation("categoriesTocategories")
  product_category_map product_category_map[]

  @@index([parent_id], map: "parent_id")
}

model complaints {
  complaint_id                       Int                @id @default(autoincrement())
  user_id                            Int
  order_id                           Int?
  type                               complaints_type?
  description                        String?            @db.Text
  evidence                           String?            @db.VarChar(500)
  status                             complaints_status? @default(pending)
  handled_by                         Int?
  created_at                         DateTime?          @default(now()) @db.Timestamp(0)
  users_complaints_user_idTousers    users              @relation("complaints_user_idTousers", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "complaints_ibfk_1")
  orders                             orders?            @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "complaints_ibfk_2")
  users_complaints_handled_byTousers users?             @relation("complaints_handled_byTousers", fields: [handled_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "complaints_ibfk_3")

  @@index([handled_by], map: "handled_by")
  @@index([order_id], map: "order_id")
  @@index([user_id], map: "user_id")
}

model conversations {
  conversation_id Int                   @id @default(autoincrement())
  buyer_id        Int
  seller_id       Int
  status          conversations_status? @default(active)
  last_message_at DateTime?             @db.DateTime(0)
  created_at      DateTime?             @default(now()) @db.Timestamp(0)
  users           users                 @relation(fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "conversations_ibfk_1")
  sellers         sellers               @relation(fields: [seller_id], references: [seller_id], onDelete: NoAction, onUpdate: NoAction, map: "conversations_ibfk_2")
  messages        messages[]

  @@index([buyer_id], map: "buyer_id")
  @@index([seller_id], map: "seller_id")
}

model coupon_usage {
  usage_id        Int       @id @default(autoincrement())
  user_id         Int?
  voucher_id      Int?
  order_id        Int?
  discount_amount Decimal?  @db.Decimal(12, 0)
  used_at         DateTime? @default(now()) @db.Timestamp(0)
  users           users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "coupon_usage_ibfk_1")
  vouchers        vouchers? @relation(fields: [voucher_id], references: [voucher_id], onDelete: NoAction, onUpdate: NoAction, map: "coupon_usage_ibfk_2")
  orders          orders?   @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "coupon_usage_ibfk_3")

  @@index([order_id], map: "order_id")
  @@index([user_id], map: "user_id")
  @@index([voucher_id], map: "voucher_id")
}

model customer_segments {
  segment_id  Int     @id @default(autoincrement())
  name        String? @db.VarChar(100)
  description String? @db.Text
}

model daily_sales_reports {
  report_id     Int       @id @default(autoincrement())
  shop_id       Int?
  report_date   DateTime? @db.Date
  total_orders  Int?
  revenue       Decimal?  @db.Decimal(12, 0)
  refund_amount Decimal?  @db.Decimal(12, 0)
  profit        Decimal?  @db.Decimal(12, 0)
  shops         shops?    @relation(fields: [shop_id], references: [shop_id], onDelete: NoAction, onUpdate: NoAction, map: "daily_sales_reports_ibfk_1")

  @@index([shop_id], map: "shop_id")
}

model flash_sales {
  flashsale_id       Int                  @id @default(autoincrement())
  name               String?              @db.VarChar(255)
  start_time         DateTime?            @db.DateTime(0)
  end_time           DateTime?            @db.DateTime(0)
  status             flash_sales_status?  @default(upcoming)
  created_at         DateTime?            @default(now()) @db.Timestamp(0)
  flashsale_products flashsale_products[]

  @@index([start_time, end_time], map: "idx_flashsale_time")
}

model flashsale_products {
  id             Int         @id @default(autoincrement())
  flashsale_id   Int
  shop_id        Int
  product_id     Int
  original_price Decimal?    @db.Decimal(12, 0)
  sale_price     Decimal?    @db.Decimal(12, 0)
  quantity       Int?
  sold_quantity  Int?        @default(0)
  flash_sales    flash_sales @relation(fields: [flashsale_id], references: [flashsale_id], onDelete: NoAction, onUpdate: NoAction, map: "flashsale_products_ibfk_1")
  shops          shops       @relation(fields: [shop_id], references: [shop_id], onDelete: NoAction, onUpdate: NoAction, map: "flashsale_products_ibfk_2")
  products       products    @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "flashsale_products_ibfk_3")

  @@index([flashsale_id], map: "flashsale_id")
  @@index([product_id], map: "product_id")
  @@index([shop_id], map: "shop_id")
}

model inventories {
  inventory_id      Int               @id @default(autoincrement())
  product_id        Int
  variant_id        Int?
  quantity          Int?              @default(0)
  reserved_quantity Int?              @default(0)
  updated_at        DateTime?         @default(now()) @db.Timestamp(0)
  products          products          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "inventories_ibfk_1")
  product_variants  product_variants? @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction, map: "inventories_ibfk_2")

  @@index([variant_id], map: "idx_inventory_variant")
  @@index([product_id], map: "product_id")
}

model inventory_transactions {
  transaction_id   Int                                      @id @default(autoincrement())
  product_id       Int?
  variant_id       Int?
  transaction_type inventory_transactions_transaction_type?
  quantity         Int?
  note             String?                                  @db.VarChar(255)
  created_at       DateTime?                                @default(now()) @db.Timestamp(0)
  products         products?                                @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "inventory_transactions_ibfk_1")

  @@index([product_id], map: "product_id")
}

model login_histories {
  login_id     Int                           @id @default(autoincrement())
  user_id      Int
  login_method login_histories_login_method? @default(password)
  device       String?                       @db.VarChar(255)
  ip_address   String?                       @db.VarChar(50)
  location     String?                       @db.VarChar(100)
  status       login_histories_status?       @default(success)
  login_time   DateTime?                     @default(now()) @db.Timestamp(0)
  users        users                         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "login_histories_ibfk_1")

  @@index([user_id], map: "user_id")
}

model logistics_zones {
  zone_id                                                            Int                   @id @default(autoincrement())
  zone_code                                                          String                @unique(map: "zone_code") @db.VarChar(10)
  zone_name                                                          String                @db.VarChar(100)
  description                                                        String?               @db.Text
  created_at                                                         DateTime?             @default(now()) @db.Timestamp(0)
  provinces                                                          provinces[]
  shipping_zone_rules_shipping_zone_rules_from_zoneTologistics_zones shipping_zone_rules[] @relation("shipping_zone_rules_from_zoneTologistics_zones")
  shipping_zone_rules_shipping_zone_rules_to_zoneTologistics_zones   shipping_zone_rules[] @relation("shipping_zone_rules_to_zoneTologistics_zones")
}

model messages {
  message_id      Int                    @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  message_type    messages_message_type? @default(text)
  content         String?                @db.Text
  file_url        String?                @db.VarChar(500)
  is_read         Boolean?               @default(false)
  created_at      DateTime?              @default(now()) @db.Timestamp(0)
  conversations   conversations          @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_1")
  users           users                  @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "messages_ibfk_2")

  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([sender_id], map: "idx_messages_sender")
}

model notifications {
  notification_id   Int                              @id @default(autoincrement())
  user_id           Int
  title             String?                          @db.VarChar(255)
  content           String?                          @db.Text
  notification_type notifications_notification_type?
  reference_id      Int?
  is_read           Boolean?                         @default(false)
  created_at        DateTime?                        @default(now()) @db.Timestamp(0)
  users             users                            @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "notifications_ibfk_1")

  @@index([user_id], map: "idx_notifications_user")
}

model order_items {
  order_item_id    Int               @id @default(autoincrement())
  order_id         Int
  product_id       Int
  variant_id       Int?
  shop_id          Int
  product_name     String?           @db.VarChar(255)
  variant_name     String?           @db.VarChar(255)
  quantity         Int?
  price            Decimal?          @db.Decimal(12, 0)
  subtotal         Decimal?          @db.Decimal(12, 0)
  orders           orders            @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_ibfk_1")
  products         products          @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_2")
  product_variants product_variants? @relation(fields: [variant_id], references: [variant_id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_3")
  shops            shops             @relation(fields: [shop_id], references: [shop_id], onDelete: NoAction, onUpdate: NoAction, map: "order_items_ibfk_4")

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "idx_order_items_product")
  @@index([shop_id], map: "shop_id")
  @@index([variant_id], map: "variant_id")
}

model order_status_history {
  history_id Int       @id @default(autoincrement())
  order_id   Int
  old_status String?   @db.VarChar(50)
  new_status String?   @db.VarChar(50)
  note       String?   @db.Text
  changed_at DateTime? @default(now()) @db.Timestamp(0)
  orders     orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction, map: "order_status_history_ibfk_1")

  @@index([order_id], map: "order_id")
}

model orders {
  order_id             Int                    @id @default(autoincrement())
  order_code           String                 @unique(map: "order_code") @db.VarChar(50)
  user_id              Int
  address_id           Int
  subtotal             Decimal?               @db.Decimal(12, 0)
  shipping_fee         Decimal?               @default(0) @db.Decimal(12, 0)
  discount_amount      Decimal?               @default(0) @db.Decimal(12, 0)
  total_amount         Decimal?               @db.Decimal(12, 0)
  status               orders_status?         @default(pending)
  note                 String?                @db.Text
  payment_qr_url       String?                @db.VarChar(500)
  checkout_token       String?                @unique(map: "uq_orders_checkout_token") @db.VarChar(80)
  created_at           DateTime?              @default(now()) @db.Timestamp(0)
  updated_at           DateTime?              @default(now()) @db.Timestamp(0)
  complaints           complaints[]
  coupon_usage         coupon_usage[]
  order_items          order_items[]
  order_status_history order_status_history[]
  users                users                  @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "orders_ibfk_1")
  addresses            addresses              @relation(fields: [address_id], references: [address_id], onDelete: NoAction, onUpdate: NoAction, map: "orders_ibfk_2")
  packages             packages[]
  payments             payments?
  reviews              reviews[]
  shipments            shipments[]

  @@index([address_id], map: "address_id")
  @@index([created_at], map: "idx_orders_created")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user")
}

model packages {
  package_id    Int         @id @default(autoincrement())
  order_id      Int
  weight        Decimal?    @db.Decimal(10, 2)
  length        Decimal?    @db.Decimal(10, 2)
  width         Decimal?    @db.Decimal(10, 2)
  height        Decimal?    @db.Decimal(10, 2)
  volume_weight Decimal?    @db.Decimal(10, 2)
  orders        orders      @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "packages_ibfk_1")
  shipments     shipments[]

  @@index([order_id], map: "order_id")
}

model payments {
  payment_id       Int                      @id @default(autoincrement())
  order_id         Int                      @unique(map: "order_id")
  payment_method   payments_payment_method?
  amount           Decimal?                 @db.Decimal(12, 0)
  payment_status   payments_payment_status? @default(pending)
  transaction_code String?                  @db.VarChar(100)
  paid_at          DateTime?                @db.DateTime(0)
  created_at       DateTime?                @default(now()) @db.Timestamp(0)
  orders           orders                   @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction, map: "payments_ibfk_1")
}

model permissions {
  permission_id    Int                @id @default(autoincrement())
  permission_code  String?            @unique(map: "permission_code") @db.VarChar(100)
  permission_name  String?            @db.VarChar(150)
  description      String?            @db.Text
  role_permissions role_permissions[]
}

model product_attributes {
  product_id   Int
  attribute_id Int
  value        String?    @db.VarChar(255)
  products     products   @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "product_attributes_ibfk_1")
  attributes   attributes @relation(fields: [attribute_id], references: [attribute_id], onDelete: Cascade, onUpdate: NoAction, map: "product_attributes_ibfk_2")

  @@id([product_id, attribute_id])
  @@index([attribute_id], map: "attribute_id")
}

model product_category_map {
  product_id  Int
  category_id Int
  products    products   @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "product_category_map_ibfk_1")
  categories  categories @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction, map: "product_category_map_ibfk_2")

  @@id([product_id, category_id])
  @@index([category_id], map: "category_id")
}

model product_media {
  media_id     Int                       @id @default(autoincrement())
  product_id   Int
  media_type   product_media_media_type? @default(image)
  url          String                    @db.VarChar(500)
  is_thumbnail Boolean?                  @default(false)
  sort_order   Int?                      @default(0)
  created_at   DateTime?                 @default(now()) @db.Timestamp(0)
  products     products                  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "product_media_ibfk_1")

  @@index([product_id], map: "idx_product_media_product")
}

model product_moderations {
  moderation_id Int                         @id @default(autoincrement())
  product_id    Int
  admin_id      Int?
  action        product_moderations_action?
  reason        String?                     @db.Text
  created_at    DateTime?                   @default(now()) @db.Timestamp(0)
  products      products                    @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "product_moderations_ibfk_1")
  users         users?                      @relation(fields: [admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "product_moderations_ibfk_2")

  @@index([admin_id], map: "admin_id")
  @@index([product_id], map: "product_id")
}

model product_statistics {
  statistic_id    Int       @id @default(autoincrement())
  product_id      Int?
  total_views     Int?      @default(0)
  total_sales     Int?      @default(0)
  total_favorites Int?      @default(0)
  average_rating  Decimal?  @db.Decimal(2, 1)
  updated_at      DateTime? @default(now()) @db.Timestamp(0)
  products        products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "product_statistics_ibfk_1")

  @@index([product_id], map: "product_id")
}

model product_variants {
  variant_id  Int                      @id @default(autoincrement())
  product_id  Int
  sku         String?                  @unique(map: "sku") @db.VarChar(100)
  price       Decimal                  @db.Decimal(12, 0)
  image       String?                  @db.VarChar(255)
  status      product_variants_status? @default(active)
  cart_items  cart_items[]
  inventories inventories[]
  order_items order_items[]
  products    products                 @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_ibfk_1")

  @@index([product_id], map: "product_id")
}

model product_views {
  view_id       Int       @id @default(autoincrement())
  user_id       Int?
  product_id    Int
  session_id    String?   @db.VarChar(100)
  view_duration Int?
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  users         users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "product_views_ibfk_1")
  products      products  @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction, map: "product_views_ibfk_2")

  @@index([product_id], map: "idx_product_views_product")
  @@index([user_id], map: "user_id")
}

model products {
  product_id             Int                      @id @default(autoincrement())
  shop_id                Int
  brand_id               Int?
  name                   String                   @db.VarChar(255)
  description            String?                  @db.Text
  status                 products_status?         @default(draft)
  rating                 Decimal?                 @default(0.0) @db.Decimal(2, 1)
  sold_quantity          Int?                     @default(0)
  created_at             DateTime?                @default(now()) @db.Timestamp(0)
  updated_at             DateTime?                @default(now()) @db.Timestamp(0)
  cart_items             cart_items[]
  flashsale_products     flashsale_products[]
  inventories            inventories[]
  inventory_transactions inventory_transactions[]
  order_items            order_items[]
  product_attributes     product_attributes[]
  product_category_map   product_category_map[]
  product_media          product_media[]
  product_moderations    product_moderations[]
  product_statistics     product_statistics[]
  product_variants       product_variants[]
  product_views          product_views[]
  shops                  shops                    @relation(fields: [shop_id], references: [shop_id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_1")
  brands                 brands?                  @relation(fields: [brand_id], references: [brand_id], onDelete: NoAction, onUpdate: NoAction, map: "products_ibfk_2")
  recommendation_logs    recommendation_logs[]
  reviews                reviews[]
  trending_products      trending_products[]
  user_behaviors         user_behaviors[]
  variant_groups         variant_groups[]
  voucher_product        voucher_product[]
  wishlists              wishlists[]

  @@index([brand_id], map: "brand_id")
