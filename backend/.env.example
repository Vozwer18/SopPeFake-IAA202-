# Local development database from compose.yaml; use separate credentials in production.
DATABASE_URL="mysql://soppe:local-development-only@127.0.0.1:3307/soppe_fake"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
PORT=3000
NODE_ENV=development
# Set to 1 only behind one trusted HTTPS reverse proxy; otherwise leave disabled.
TRUST_PROXY=0
